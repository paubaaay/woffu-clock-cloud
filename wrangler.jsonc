{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woffu-clock-cloud",
  "main": "src/index-v6.js",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
